<IfModule mod_rewrite.c>
    # Activation du moteur de réécriture d'URL
    RewriteEngine On

    # Si la ressource demandée n'est pas un fichier physique existant...
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # ...et si ce n'est pas un dossier physique existant...
    RewriteCond %{REQUEST_FILENAME} !-d

    # ...alors on redirige tout le trafic vers notre Front Controller (index.php)
    # L'indicateur [QSA] conserve les paramètres GET existants
    # L'indicateur [L] arrête le traitement des règles suivantes
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Optionnel : Sécurité supplémentaire pour empêcher le listage des dossiers
Options -Indexes

# Optionnel : Bloquer l'accès direct à la base de données SQLite si elle est à la racine
<FilesMatch "\.(sqlite|db)$">
    Order allow,deny
    Deny from all
</FilesMatch>